{
  "version": 1,
  "sdk_version": "0.28.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://gfhbytrfrwzkhfbsiptw.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "amaa-foundation-hub",
      "version": "0.1.0",
      "title": "AMAA Foundation Hub"
    },
    "tools": [
      {
        "name": "list_projects",
        "title": "Lister les projets",
        "description": "Liste les projets de l'AMAA (slug, statut, titres trilingues, lieu, période).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "default": 20,
              "description": "Nombre maximum de projets.",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "status": {
              "description": "Filtrer par statut.",
              "type": "string",
              "enum": [
                "done",
                "upcoming"
              ]
            }
          }
        },
        "outputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "projects": {
              "type": "array",
              "items": {}
            }
          },
          "required": [
            "projects"
          ]
        }
      },
      {
        "name": "get_project",
        "title": "Détail d'un projet",
        "description": "Récupère le détail complet d'un projet de l'AMAA à partir de son slug.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "slug": {
              "type": "string",
              "minLength": 1,
              "description": "Slug du projet, ex. « vaccination-vidangeurs »."
            }
          },
          "required": [
            "slug"
          ]
        },
        "outputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "project": {}
          },
          "required": [
            "project"
          ]
        }
      },
      {
        "name": "list_news",
        "title": "Lister les actualités",
        "description": "Liste les actualités de l'AMAA (slug, date, catégorie, titres et chapôs trilingues).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "default": 20,
              "description": "Nombre maximum d'actualités.",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "news": {
              "type": "array",
              "items": {}
            }
          },
          "required": [
            "news"
          ]
        }
      },
      {
        "name": "list_partners",
        "title": "Lister les partenaires",
        "description": "Liste les partenaires institutionnels et opérationnels de l'AMAA.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "default": 50,
              "description": "Nombre maximum de partenaires.",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "partners": {
              "type": "array",
              "items": {}
            }
          },
          "required": [
            "partners"
          ]
        }
      },
      {
        "name": "list_contact_messages",
        "title": "Lister les messages de contact",
        "description": "Liste les messages reçus via le formulaire de contact. Réservé aux administrateurs de l'AMAA (contrôlé côté base).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "default": 20,
              "description": "Nombre maximum de messages.",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "messages": {
              "type": "array",
              "items": {}
            }
          },
          "required": [
            "messages"
          ]
        }
      }
    ]
  }
}
